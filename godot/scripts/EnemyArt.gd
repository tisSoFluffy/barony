extends RefCounted
class_name EnemyArt
## Procedural enemy billboards, ported from the web build. Each draws into a
## Painter sized per the web S(w,h). Sizes (w,h):
##   orc 64x84, kobold 48x58, murloc 52x62, skeleton 56x78, troll 56x86, necro 56x84, ogre 96x112

static func draw_orc(g: Painter) -> void:
	g.line(Painter.hex("4a3015"), 9, 22, 5, 72, 4)
	g.shp(Painter.hex("9aa2ac"), func(p): p.move_to(8, 16); p.quad_to(26, 22, 10, 36); p.quad_to(2, 26, 8, 16))
	g.rrect(Painter.hex("4e3520"), 22, 58, 9, 17, 3); g.rrect(Painter.hex("4e3520"), 34, 58, 9, 17, 3)
	g.rrect(Painter.hex("2c1d10"), 20, 72, 12, 9, 3); g.rrect(Painter.hex("2c1d10"), 33, 72, 12, 9, 3)
	g.rrect(Painter.hex("4e8f3a"), 17, 33, 31, 29, 7)
	g.shp(Painter.hex("5e4226"), func(p): p.move_to(18, 36); p.line_to(46, 56); p.line_to(46, 62); p.line_to(18, 42))
	g.rrect(Painter.hex("3a2615"), 17, 54, 31, 8, 2); g.ell(Painter.hex("d8b050"), 32, 58, 5, 4)
	g.rrect(Painter.hex("478235"), 8, 35, 11, 24, 5); g.rrect(Painter.hex("478235"), 46, 35, 11, 24, 5)
	g.ell(Painter.hex("3f7530"), 12, 60, 6, 5); g.ell(Painter.hex("3f7530"), 52, 60, 6, 5)
	g.ell(Painter.hex("6b4226"), 14, 31, 13, 10); g.ell(Painter.hex("6b4226"), 50, 31, 13, 10)
	g.tri(Painter.hex("9aa2ac"), 7, 26, 13, 12, 17, 26); g.tri(Painter.hex("9aa2ac"), 47, 26, 51, 12, 57, 26)
	g.rrect(Painter.hex("4e8f3a"), 24, 9, 17, 15, 5)
	g.rrect(Painter.hex("478235"), 22, 19, 21, 9, 3)
	g.tri(Painter.hex("f0ead8"), 25, 22, 27, 13, 30, 22); g.tri(Painter.hex("f0ead8"), 35, 22, 38, 13, 40, 22)
	g.dot(Painter.hex("ff3020"), 28, 15, 1.8); g.dot(Painter.hex("ff3020"), 37, 15, 1.8)
	g.rect_fill(Painter.hex("170f06"), 25, 10, 7, 3); g.rect_fill(Painter.hex("170f06"), 33, 10, 7, 3)
	g.ell(Painter.hex("1a1208"), 32, 6, 5, 4)

static func draw_kobold(g: Painter) -> void:
	g.rrect(Painter.hex("7a5a38"), 16, 26, 16, 18, 6)
	g.rrect(Painter.hex("5e4226"), 14, 40, 8, 12, 3); g.rrect(Painter.hex("5e4226"), 26, 40, 8, 12, 3)
	g.rrect(Painter.hex("6e5232"), 10, 28, 7, 13, 3); g.rrect(Painter.hex("6e5232"), 31, 28, 7, 13, 3)
	g.line(Painter.hex("4a3015"), 37, 30, 43, 48, 3)
	g.tri(Painter.hex("9aa2ac"), 32, 28, 44, 26, 39, 33)
	g.ell(Painter.hex("8a6a42"), 24, 18, 11, 9)
	g.ell(Painter.hex("a8845a"), 24, 23, 6, 4)
	g.tri(Painter.hex("8a6a42"), 11, 16, 15, 4, 19, 14); g.tri(Painter.hex("8a6a42"), 29, 14, 33, 4, 37, 16)
	g.dot(Painter.hex("ffd040"), 19, 15, 2); g.dot(Painter.hex("ffd040"), 29, 15, 2)
	g.dot(Painter.hex("170f06"), 19, 15, 1); g.dot(Painter.hex("170f06"), 29, 15, 1)
	g.rrect(Painter.hex("e8e0c8"), 21, 4, 6, 7, 2)
	g.ell(Painter.hex("ffa020"), 24, 1, 3, 4); g.dot(Painter.hex("ffe060"), 24, 1, 1.6)

static func draw_murloc(g: Painter) -> void:
	g.line(Painter.hex("4a3015"), 43, 14, 43, 52, 3)
	g.tri(Painter.hex("9aa2ac"), 40, 14, 43, 4, 46, 14)
	g.rrect(Painter.hex("2fa48f"), 16, 30, 18, 16, 6)
	g.ell(Painter.hex("bfe8c8"), 25, 40, 7, 6)
	g.rrect(Painter.hex("27907c"), 13, 44, 8, 12, 3); g.rrect(Painter.hex("27907c"), 29, 44, 8, 12, 3)
	g.rrect(Painter.hex("27907c"), 9, 31, 7, 12, 3); g.rrect(Painter.hex("27907c"), 34, 31, 7, 12, 3)
	g.ell(Painter.hex("2fa48f"), 25, 18, 14, 12)
	g.shp(Painter.hex("ff8c3a"), func(p): p.move_to(13, 12); p.quad_to(25, -8, 37, 12); p.quad_to(25, 6, 13, 12))
	g.dot(Painter.hex("ffd840"), 18, 16, 3.6); g.dot(Painter.hex("ffd840"), 32, 16, 3.6)
	g.dot(Painter.hex("170f06"), 18, 16, 1.6); g.dot(Painter.hex("170f06"), 32, 16, 1.6)
	g.shp(Painter.hex("1d6e5e"), func(p): p.move_to(17, 25); p.quad_to(25, 30, 33, 25); p.quad_to(25, 27, 17, 25))

static func draw_skeleton(g: Painter) -> void:
	g.line(Painter.hex("5e2a20"), 47, 30, 53, 66, 3.4)
	g.shp(Painter.hex("8a4a3a"), func(p): p.move_to(44, 28); p.line_to(50, 28); p.line_to(47, 14))
	g.rrect(Painter.hex("d8d2c0"), 20, 30, 16, 22, 5)
	for i in range(4):
		g.line(Painter.hex("170f06"), 22, 35 + i * 5, 34, 35 + i * 5, 1.6)
	g.rrect(Painter.hex("c8c2b0"), 20, 52, 7, 20, 3); g.rrect(Painter.hex("c8c2b0"), 29, 52, 7, 20, 3)
	g.rrect(Painter.hex("c8c2b0"), 12, 31, 6, 19, 3); g.rrect(Painter.hex("c8c2b0"), 38, 31, 6, 19, 3)
	g.ell(Painter.hex("e8e2d0"), 28, 16, 11, 10)
	g.rrect(Painter.hex("e8e2d0"), 22, 23, 12, 6, 2)
	g.dot(Painter.hex("40c8ff"), 23, 15, 2.6); g.dot(Painter.hex("40c8ff"), 33, 15, 2.6)
	g.dot(Painter.hex("0a3a50"), 23, 15, 1.1); g.dot(Painter.hex("0a3a50"), 33, 15, 1.1)
	g.rect_fill(Painter.hex("170f06"), 24, 24, 1.5, 4); g.rect_fill(Painter.hex("170f06"), 28, 24, 1.5, 4); g.rect_fill(Painter.hex("170f06"), 32, 24, 1.5, 4)
	g.tri(Painter.hex("7a7466"), 16, 10, 12, 0, 20, 7); g.tri(Painter.hex("7a7466"), 40, 10, 44, 0, 36, 7)


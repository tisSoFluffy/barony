	g.line(Painter.hex("3a3142"), 46, 16, 46, 72, 3.4)
	g.ell(Painter.hex("d8d2c0"), 46, 11, 5, 6); g.dot(Painter.hex("7aff50"), 44, 10, 1.5); g.dot(Painter.hex("7aff50"), 48, 10, 1.5)
	g.shp(Painter.hex("221a2e"), func(p): p.move_to(17, 28); p.line_to(39, 28); p.line_to(46, 76); p.line_to(10, 76))
	g.rrect(Painter.hex("16101e"), 10, 70, 36, 7, 3)
	g.rrect(Painter.hex("5a3a78"), 19, 44, 18, 5, 2)
	g.dot(Painter.hex("7aff50"), 24, 46.5, 1.4); g.dot(Painter.hex("7aff50"), 30, 46.5, 1.4)
	g.rrect(Painter.hex("1c1526"), 9, 30, 9, 20, 4); g.rrect(Painter.hex("1c1526"), 38, 30, 9, 20, 4)

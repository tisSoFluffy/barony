	g.rrect(Painter.hex("2f8c88"), 18, 32, 23, 26, 6)
	g.shp(Painter.hex("b03a2a"), func(p): p.move_to(19, 34); p.line_to(40, 52); p.line_to(40, 58); p.line_to(19, 40))
	g.rrect(Painter.hex("2a7a78"), 11, 33, 8, 24, 4); g.rrect(Painter.hex("2a7a78"), 40, 30, 8, 22, 4)
	g.ell(Painter.hex("236a66"), 15, 58, 5, 4); g.ell(Painter.hex("236a66"), 47, 28, 5, 4)
